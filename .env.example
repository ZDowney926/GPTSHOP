# 示例模板：请在 Vercel 环境变量中填写真实值，不要把真实密钥提交到仓库
APP_BASE_URL=https://your-site.vercel.app

# 支付宝应用基础信息
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_KEY_TYPE=PKCS8

# 公钥模式：至少配置这一项
ALIPAY_PUBLIC_KEY=

# 证书模式：如果你用证书模式，就填下面三项，并可不填 ALIPAY_PUBLIC_KEY
ALIPAY_APP_CERT=
ALIPAY_PUBLIC_CERT=
ALIPAY_ROOT_CERT=

# 可选项
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
ALIPAY_ORDER_TIMEOUT_MINUTES=10
